# ==============================================================================
# Database Configuration (PostgreSQL + Prisma)
# ==============================================================================
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/spoiler_free_map?schema=public"

# ==============================================================================
# AI / LLM Configuration (Tahap 3 - Wikitext Ingestion)
# Dapatkan API key di https://aistudio.google.com/app/apikey
# ==============================================================================
GEMINI_API_KEY="your-gemini-api-key-here"

# Model dieksekusi berurutan: jika model pertama limit/error, otomatis beralih ke model berikutnya (pisahkan dengan koma)
GEMINI_MODEL="gemini-3.5-flash, gemini-3.5-flash-lite, gemini-flash-lite-latest, gemini-3.1-flash-lite, gemini-3-flash-preview"

# Groq API Fallback (digunakan otomatis jika Gemini limit / 429)
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL="openai/gpt-oss-120b"
