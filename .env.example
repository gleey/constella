# ==============================================================================
# Database Configuration (PostgreSQL + Prisma)
# ==============================================================================
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/spoiler_free_map?schema=public"

# ==============================================================================
# AI / LLM Configuration (Tahap 3 - Wikitext Ingestion)
# Fallback Chain: 1. Gemini Utama -> 2. Groq -> 3. OpenRouter -> 4. Gemini Gemma
# Dapatkan Gemini API key di https://aistudio.google.com/app/apikey
# ==============================================================================
# 1 & 4. Gemini Utama dan Gemini Gemma (menggunakan GEMINI_API_KEY yang sama)
GEMINI_API_KEY="your-gemini-api-key-here"

# 1. Model Gemini Utama (dieksekusi berurutan: jika model pertama limit/error, otomatis beralih ke berikutnya)
GEMINI_MODEL="gemini-3.5-flash, gemini-3.5-flash-lite, gemini-flash-lite-latest, gemini-3.1-flash-lite, gemini-3-flash-preview"

# 2. Groq API Fallback (digunakan jika Gemini limit / 429)
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL="openai/gpt-oss-120b"

# 3. OpenRouter API Fallback (digunakan jika Gemini & Groq gagal / limit)
OPENROUTER_API_KEY="your-openrouter-api-key-here"
OPENROUTER_MODEL="openrouter/free"

# 4. Gemini Gemma Fallback (digunakan jika Gemini, Groq, dan OpenRouter gagal / limit)
# Dieksekusi via Gemini API menggunakan GEMINI_API_KEY yang sama di atas
GEMMA_MODEL="gemini/gemma-4-31b-it, gemini/gemma-4-26b-a4b-it"

# ==============================================================================
# Security & Admin Authentication
# ==============================================================================
# Token rahasia yang melindungi seluruh endpoint admin & operasi mutasi.
# Di lokal boleh nilai default; di production WAJIB di-set ke string acak panjang.
ADMIN_SECRET="constella-admin-secret"

# Login admin via username + password (form /admin/login).
# Simpan HANYA hash scrypt, bukan password plaintext. Generate dengan:
#   npx tsx -e "import('./src/lib/admin-password.ts').then(m=>console.log(m.hashAdminPassword('PASSWORD_BARU')))"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""

# Opsional: sembunyikan lokasi halaman admin. Jika di-set (mis. "console-x7k29q"),
# UI admin hidup di /<ADMIN_PATH> (mis. constella.com/console-x7k29q) dan /admin
# biasa dibalas 404. Ini HANYA obscurity (mengurangi noise scanner) — perlindungan
# sesungguhnya tetap password + signed cookie di atas. Kosongkan untuk pakai /admin.
# Ganti nilainya dengan string acak yang hanya kamu tahu saat deploy.
ADMIN_PATH=""

# ==============================================================================
# Serverless Stability (opsional)
# ==============================================================================
# Set "true" pada server/VM/VPS untuk mengaktifkan daemon in-app.
# Daemon Tier 1 (catalog sync) auto-start saat web dijalankan — tanpa AI.
# Biarkan kosong saat deploy serverless (Vercel) — gunakan cron eksternal.
ENABLE_IN_APP_DAEMON="true"

# Set "true" untuk mengaktifkan lore sync otomatis berkala (MEMAKAN TOKEN AI).
# Tier 2 sync (Gemini/Groq) akan berjalan setiap LORE_SYNC_INTERVAL_HOURS jam.
# Biarkan kosong jika ingin lore sync manual via admin panel saja.
# Catatan: LORE_SYNC_INTERVAL_HOURS hanya dipakai bila ENABLE_AUTO_LORE_SYNC="true".
ENABLE_AUTO_LORE_SYNC=""
# Default mingguan (168 jam) — cadence paling hemat token jika otomatis diaktifkan.
LORE_SYNC_INTERVAL_HOURS="168"
# Batas seri per siklus otomatis (0 = semua). Batch kecil menyebarkan biaya token.
LORE_SYNC_BATCH="2"
# "true" = hasil AI masuk DraftIngestion (PENDING) dan harus disetujui admin sebelum terbit.
LORE_SYNC_REVIEW="true"
